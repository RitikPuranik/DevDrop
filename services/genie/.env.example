# ========================================
# AI SERVICE (Genie engine)
# Standalone multi-agent code-generation service. The DevDrop-facing service name is ai-service. DevDrop's backend is the
# only expected caller (see SERVICE_API_KEY below) — this service should
# never be exposed directly to a browser.
# ========================================

NODE_ENV=production
PORT=3001

# Origin allowed to open a Socket.io connection directly to Genie (only
# needed if you choose to proxy generation progress events; DevDrop's
# backend does not require this for the default polling integration).
FRONTEND_URL=https://devdrop.example.com

# ----------------------------------------
# LLM providers (required)
# Genie's coding agents use Gemini; its review agents (Security Sentinel,
# Performance Profiler, Bug Hunter, Quality Assurance, Chat/Doc agents)
# use OpenAI. Both are required for the full agent roster to work.
# ----------------------------------------
GOOGLE_API_KEY=


# Optional: only needed if you want Genie's AI image-generation tool
# (Runware) available to the agents. Safe to leave blank.
RUNWARE_API_KEY=

# ----------------------------------------
# Storage (required)
# Genie persists generations, chat history, and background jobs in its own
# Supabase project — deliberately separate from DevDrop's MongoDB so the
# two services stay independently deployable (see services/genie/README).
# ----------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ----------------------------------------
# Background jobs (required)
# Used by Genie's Bull queues for generation/chat/background jobs.
# ----------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------
# Service-to-service auth (required — DevDrop integration)
# DevDrop's backend sends this as the X-Service-Key header, plus an
# X-User-Id header identifying the already-authenticated DevDrop user, on
# every request. Must match AI_SERVICE_TOKEN in backend/.env exactly.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------
SERVICE_API_KEY=

# ----------------------------------------
# Optional: GitHub
# DevDrop already owns GitHub OAuth/repo-push for published projects (see
# backend/src/services/github.service.js). Only set this if you want
# Genie's own GitHub agent/MCP tools (PRs, issues) available; DevDrop does
# not require it for the generate -> DevDrop -> GitHub pipeline.
# ----------------------------------------
GENIE_BOT_GITHUB_TOKEN=
GENIE_BOT_GITHUB_USERNAME=

LOG_LEVEL=info
