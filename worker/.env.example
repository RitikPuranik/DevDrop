# ========================================
# WORKER SERVICE
# Only what the Worker actually needs — do NOT copy the Backend .env here.
# ========================================
NODE_ENV=development
PORT=4000
WORKER_URL=http://localhost:4000

# Base URL of the Backend (used for signed Kashi progress callbacks).
BACKEND_URL=http://localhost:5000

# Shared secret used to HMAC-sign Backend <-> Worker internal webhooks.
# Must match INTERNAL_WEBHOOK_SECRET in backend/.env exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_WEBHOOK_SECRET=your_shared_internal_webhook_secret

# Milliseconds to wait for running jobs on SIGTERM/SIGINT before exiting
# (anything still running is recovered by BullMQ's stalled-job detection).
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# ========================================
# QUEUE (BullMQ on Upstash) — this process runs deployment-queue + events-queue
# ========================================
# Queue database, TCP/TLS URL (rediss://...). Used ONLY by BullMQ. Same value as backend/.env.
QUEUE_REDIS_URL=rediss://default:your_password@your-queue-db.upstash.io:6379
# Optional (the worker invalidates listing cache through Website model hooks): same cache DB as the backend.
# CACHE_REDIS_URL=rediss://default:your_password@your-cache-db.upstash.io:6379
# Parallel jobs per queue. Deployments are API-bound but heavy on GitHub/Vercel limits: keep at 1 on free tiers.
DEPLOYMENT_QUEUE_CONCURRENCY=1
EVENTS_QUEUE_CONCURRENCY=2
# Per-job hard stops (ms). Maintenance (backup/cleanup) shares events-queue and gets its own limit.
# DEPLOYMENT_JOB_TIMEOUT_MS=2700000
# EVENTS_JOB_TIMEOUT_MS=60000
# MAINTENANCE_JOB_TIMEOUT_MS=1800000
# Retry policy (bounded, exponential backoff)
# DEPLOYMENT_JOB_ATTEMPTS=2
# EVENTS_JOB_ATTEMPTS=4
# EVENTS_JOB_BACKOFF_MS=5000
# Outbox republisher cadence and queue health thresholds
# OUTBOX_SWEEP_INTERVAL_MS=60000
# QUEUE_DEPTH_WARN=100
# QUEUE_FAILED_WARN=25
# QUEUE_WAITING_WARN_MS=600000

# ========================================
# EMAIL (events-queue sends all transactional email) — same values as backend/.env
# ========================================
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=hello@yourdomain.com
ADMIN_EMAILS=admin@example.com
FRONTEND_URL=http://localhost:5173
# Decrypts the verification/reset token carried by queued security emails and stored provider/GitHub tokens.
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key

# ========================================
# DEPLOYMENTS / GITHUB EXPORT / KASHI (deployment-queue runs these) — same values as backend/.env
# ========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
VERCEL_CLIENT_ID=your_vercel_client_id
VERCEL_CLIENT_SECRET=your_vercel_client_secret
# RENDER_DEFAULT_PLAN=free
# RENDER_DEFAULT_REGION=oregon
AI_SERVICE_URL=http://localhost:3001
AI_SERVICE_TOKEN=your_shared_ai_service_secret
# DEPLOYMENT_AI_PLAN_TIMEOUT_MS=20000

# ========================================
# DATABASE
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devdrop

# ========================================
# SUPABASE (marketplace storage — Supabase cleanup + backup source)
# ========================================
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=marketplace-files
# Runs every Sunday at 03:00 UTC.
SUPABASE_CLEANUP_CRON=0 3 * * 0

# ========================================
# BACKUPS (second MongoDB cluster + second Supabase project)
# Leave blank to disable — the scheduled backup auto-skips if unset.
# ========================================
BACKUP_MONGODB_URI=mongodb+srv://username:password@backup-cluster.mongodb.net/devdrop
BACKUP_SUPABASE_URL=https://yourbackupproject.supabase.co
BACKUP_SUPABASE_SERVICE_ROLE_KEY=your_backup_project_service_role_key
BACKUP_SUPABASE_BUCKET_NAME=marketplace-files
# Every N hours (decimals allowed). Or remove and use BACKUP_CRON_SCHEDULE="0 2 * * *".
BACKUP_INTERVAL_HOURS=24
# BACKUP_CRON_SCHEDULE=0 2 * * *

# ========================================
# AI STUDIO CLEANUP (temporary project storage)
# ========================================
AI_STUDIO_SUPABASE_URL=
AI_STUDIO_SUPABASE_SERVICE_ROLE_KEY=
AI_STUDIO_SUPABASE_BUCKET=ai-studio-projects
AI_STUDIO_INACTIVITY_THRESHOLD_MS=1200000
# Default: every 5 minutes
AI_STUDIO_CLEANUP_CRON=*/5 * * * *

# Timezone for cron-syntax schedules above.
CRON_TIMEZONE=UTC
