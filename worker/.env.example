# ========================================
# WORKER SERVICE
# Only what the Worker actually needs — do NOT copy the Backend .env here.
# ========================================
NODE_ENV=development
PORT=4000

# Base URL of the Backend (used for the task-result callback webhook).
BACKEND_URL=http://localhost:5000

# Shared secret used to HMAC-sign Backend <-> Worker internal webhooks.
# Must match INTERNAL_WEBHOOK_SECRET in backend/.env exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_WEBHOOK_SECRET=your_shared_internal_webhook_secret

# Max tasks running at once (extra tasks wait in the in-memory queue).
WORKER_CONCURRENCY=2
# Max tasks allowed to wait; further webhooks get 429.
WORKER_MAX_QUEUE=50
# Milliseconds to wait for running tasks on SIGTERM/SIGINT before exiting.
WORKER_SHUTDOWN_TIMEOUT_MS=25000

# ========================================
# DATABASE
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devdrop

# ========================================
# SUPABASE (marketplace storage — Supabase cleanup + backup source)
# ========================================
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=marketplace-files
# Runs every Sunday at 03:00 UTC.
SUPABASE_CLEANUP_CRON=0 3 * * 0

# ========================================
# BACKUPS (second MongoDB cluster + second Supabase project)
# Leave blank to disable — the scheduled backup auto-skips if unset.
# ========================================
BACKUP_MONGODB_URI=mongodb+srv://username:password@backup-cluster.mongodb.net/devdrop
BACKUP_SUPABASE_URL=https://yourbackupproject.supabase.co
BACKUP_SUPABASE_SERVICE_ROLE_KEY=your_backup_project_service_role_key
BACKUP_SUPABASE_BUCKET_NAME=marketplace-files
# Every N hours (decimals allowed). Or remove and use BACKUP_CRON_SCHEDULE="0 2 * * *".
BACKUP_INTERVAL_HOURS=24
# BACKUP_CRON_SCHEDULE=0 2 * * *

# ========================================
# AI STUDIO CLEANUP (temporary project storage)
# ========================================
AI_STUDIO_SUPABASE_URL=
AI_STUDIO_SUPABASE_SERVICE_ROLE_KEY=
AI_STUDIO_SUPABASE_BUCKET=ai-studio-projects
AI_STUDIO_INACTIVITY_THRESHOLD_MS=1200000
# Default: every 5 minutes
AI_STUDIO_CLEANUP_CRON=*/5 * * * *

# Timezone for cron-syntax schedules above.
CRON_TIMEZONE=UTC
