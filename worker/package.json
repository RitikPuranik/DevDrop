{
  "name": "devdrop-worker",
  "version": "1.0.0",
  "description": "DevDrop Worker — runs long-running, background and scheduled jobs so the main backend stays focused on request/response traffic.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ext js,json,env server.js",
    "test": "jest",
    "postinstall": "npm --prefix ../backend install --omit=dev --no-audit --no-fund"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
