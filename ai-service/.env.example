# ========================================
# SERVER
# ========================================
PORT=3001

# Shared secret checked against the backend's X-Service-Key header.
# Must match AI_SERVICE_TOKEN in backend/.env exactly.
SERVICE_API_KEY=your_shared_ai_service_secret

# ========================================
# CONCURRENCY / JOBS
# ========================================
# Max Gemini generations running at once. Queued jobs wait for a free slot.
AI_CONCURRENCY=1
# How long a completed/failed job's result stays available for polling
# before it's evicted from the in-memory store (milliseconds).
AI_JOB_TTL_MS=1800000

# ========================================
# AI STUDIO (Gemini)
# ========================================
# Gemini 2.0 Flash was shut down on June 1, 2026; use a current Gemini 3
# Get a key at https://aistudio.google.com/app/apikey
#
# GEMINI_API_KEY (single key) and GEMINI_API_KEYS (comma-separated) are now
# only a bootstrap fallback — used automatically when no key has been
# added yet through Admin Panel -> Gemini Pool. Once at least one key
# exists in the pool (MongoDB-backed), these env vars are ignored and the
# pool takes over: multiple keys, automatic failover on 429/503/timeout,
# and per-key health tracking. Existing single-key installs keep working
# with no changes required.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.8-flash
# Maximum time this service waits for a complete app response from Gemini.
GEMINI_TIMEOUT_MS=180000

# ========================================
# GEMINI API KEY POOL — DEDICATED DATABASE
# Backend and ai-service both connect to this dedicated MongoDB database.
# Backend encrypts Gemini credentials before writing them; ai-service reads
# ciphertext and decrypts only immediately before Gemini requests.
GEMINI_MONGODB_URI=mongodb+srv://username:password@gemini-pool-cluster.mongodb.net/devdrop-gemini-pool

# MUST exactly match backend/.env's value. Used ONLY for Gemini API-key
# encryption/decryption. Never reuse TOKEN_ENCRYPTION_KEY here.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_GEMINI_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# How long (ms) the pool caches Mongo-loaded config before re-reading.
GEMINI_POOL_REFRESH_MS=5000

# Max Gemini requests a single key may have in flight at once. Leave unset
# for no per-key cap (only AI_CONCURRENCY governs total concurrency).
# GEMINI_PER_KEY_CONCURRENCY=1
# Maximum different credentials tried for one Gemini request. Default is all
# currently loaded keys. Set lower only if you intentionally want bounded failover.
GEMINI_POOL_MAX_KEY_ATTEMPTS=57

# Ceiling for Gemini pool exponential backoff after repeated key failures.
GEMINI_POOL_MAX_COOLDOWN_MS=300000

# ========================================
# ORCHESTRATOR TIMEOUTS
# ========================================
# Single overall timeout for the ENTIRE whole-website generation pipeline
# (requirements -> design -> architecture -> code-gen for every file ->
# integration -> validation/debug repair loop). There is no longer a
# separate per-agent/per-stage timeout.
WEBSITE_GENERATION_TIMEOUT_MS=900000

# Single overall timeout for the ENTIRE incremental edit pipeline
# (relevant-files detection -> edit agent -> validation/debug repair loop).
WEBSITE_EDIT_TIMEOUT_MS=300000
