# ========================================
# SERVER
# ========================================
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# ========================================
# AI PROVIDER
# Selects which provider class app the service uses — see providers/factory.py.
# Nothing outside providers/ and config.py should ever read a provider-specific
# env var directly (Section 5: "centralize model configuration").
# ========================================
AI_PROVIDER=gemini

# --- Gemini ---
# Get from: aistudio.google.com/apikey
GEMINI_API_KEY=
# No default is set in code on purpose — check ai.google.dev/gemini-api/docs/models
# for current model names before picking one (e.g. gemini-2.0-flash).
GEMINI_MODEL=

# --- Ollama (local — no API key, useful for dev without burning Gemini quota) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ========================================
# USAGE LIMITS (Section 21)
# Defined here now so nothing downstream needs a second place to configure
# them. Not enforced yet — enforcement lands with the job system (Phase 6+).
# ========================================
MAX_GENERATIONS_PER_DAY=5
MAX_AI_EDITS_PER_DAY=20
MAX_GENERATION_DURATION_SECONDS=600

# How many times an agent retries with a repair prompt after the model
# returns output that fails schema validation (Phase 2, Section 7).
MAX_SCHEMA_RETRIES=2

# ========================================
# BUILD SANDBOX + REPAIR LOOP (Phase 4)
# ========================================
# Debug+patch+rebuild cycles allowed after the first build attempt before
# giving up and returning a structured failure.
MAX_BUILD_REPAIR_ATTEMPTS=3
# Applies to the whole npm install + npm run build sequence combined.
BUILD_TIMEOUT_SECONDS=120
# Documented, not enforced by the local sandbox (dev-only, OS-level
# subprocess isolation — no real network boundary). See README's Security
# Model section before relying on this for anything at scale.
BUILD_NETWORK_MODE=restricted
MAX_BUILD_OUTPUT_CHARS=20000

# ========================================
# INTERNAL SERVICE AUTH (Section 23)
# Shared secret the DevDrop Node backend will send on every request so this
# service only ever answers to its own backend, never the public internet.
# Once set, it's required on internal test/debug endpoints (/v1/planning/*,
# /v1/generation/*, /v1/build/*) via an X-Service-Auth header. Left blank, those endpoints stay open for
# local development — that's fine for now since nothing calls them but you.
# Full Node <-> AI-service auth on the real generation endpoints lands in
# Phase 6.
# ========================================
# SERVICE_AUTH_TOKEN=

# ========================================
# PERSISTENCE (Phase 5)
# ========================================
# Left unset, the service falls back to an in-memory repository — fine for
# local development, but generated projects will NOT survive a restart and
# this fallback logs a warning every time it's used. Set this to a real
# MongoDB connection string for anything that needs to persist.
# AI_DATABASE_URL=mongodb://localhost:27017
# A logically separate database from DevDrop's own core database — the AI
# service owns this one; the Node backend's Mongoose models are never
# imported here and this database is never queried directly by the Node
# backend (see README's Phase 0 findings on why AIProject needs its own
# model in the first place).
AI_DATABASE_NAME=devdrop_ai

# Project-listing pagination bounds (Section 15).
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========================================
# GEMINI PROJECT POOL (dynamic multi-credential scheduling)
# ========================================
# Opt-in. Leave this false (or unset) and nothing changes: AI_PROVIDER=gemini
# keeps using the single GEMINI_API_KEY/GEMINI_MODEL pair above, exactly as
# before. Set it true to route Gemini calls through a load-aware scheduler
# across an arbitrary number of projects/credentials instead of one.
#
# Turning this on with GEMINI_API_KEY already set migrates that one key into
# a single pool entry automatically the first time the service starts — you
# don't lose a working credential just by flipping this flag. From there,
# manage the pool's actual members through the admin API
# (GET/POST/PATCH/DELETE /v1/admin/gemini-projects, POST .../test), not
# through more environment variables — there is deliberately no
# GEMINI_API_KEY_1..N here. See docs/GEMINI_PROJECT_POOL.md.
# GEMINI_POOL_ENABLED=true

# How many additional projects a single request will fail over to after its
# first pick fails with a retryable error (rate limit, server error,
# timeout, auth, ...). Total attempts per request = this + 1. A prompt-level
# error (bad/blocked content) never triggers failover regardless of this
# setting — see docs/GEMINI_PROJECT_POOL.md's "Failover behavior" section.
GEMINI_MAX_PROJECT_FAILOVERS=2

# Selects which pool entries are eligible when a caller doesn't pin a model
# (nothing in this codebase does today — every agent just calls
# ai_gateway.generate()). Leave unset to make every model in the pool
# eligible for every request.
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

GEMINI_REQUEST_TIMEOUT_MS=60000
# Base and cap for the exponential-backoff-with-jitter cooldown a project
# gets after an RPM/TPM/temporary failure (Section 10).
GEMINI_COOLDOWN_DEFAULT_MS=30000
GEMINI_COOLDOWN_MAX_MS=900000
# How long a request holds its project reservation before it's treated as an
# abandoned/crashed worker's lease and freed automatically (Section 15).
GEMINI_LEASE_TTL_SECONDS=120

# Placeholder, not a verified claim about Google's own daily-quota reset
# instant — confirm against Gemini's current documented behavior before
# relying on this in production. See docs/GEMINI_PROJECT_POOL.md.
GEMINI_DAILY_RESET_HOUR_UTC=0

# Internal budget guard (Section 13) — always an estimate, never Google's
# authoritative billing. 0 cost rates (the default) means monthlyUsage never
# accrues even if a project has a monthlyBudget configured; set real rates
# for your model(s) to make the guard meaningful.
GEMINI_BUDGET_GUARD_ENABLED=true
GEMINI_BUDGET_WARNING_THRESHOLD=0.7
GEMINI_BUDGET_CRITICAL_THRESHOLD=0.9
# GEMINI_COST_PER_1K_INPUT_TOKENS=0.0
# GEMINI_COST_PER_1K_OUTPUT_TOKENS=0.0

# Pre-request token estimate used for TPM eligibility (Section 11) — a
# chars-per-token heuristic, not a real tokenizer call. Corrected to
# Gemini's own reported usage after every real request.
GEMINI_ESTIMATED_CHARS_PER_TOKEN=4.0
GEMINI_ESTIMATED_OUTPUT_TOKENS=2000

