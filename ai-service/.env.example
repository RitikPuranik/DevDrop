# ========================================
# SERVER
# ========================================
PORT=3001

# Shared secret checked against the backend's X-Service-Key header.
# Must match AI_SERVICE_TOKEN in backend/.env exactly.
SERVICE_API_KEY=your_shared_ai_service_secret

# ========================================
# CONCURRENCY / JOBS
# ========================================
# Max Gemini generations running at once. Queued jobs wait for a free slot.
AI_CONCURRENCY=1
# How long a completed/failed job's result stays available for polling
# before it's evicted from the in-memory store (milliseconds).
AI_JOB_TTL_MS=1800000

# ========================================
# AI STUDIO (Gemini)
# ========================================
# Gemini 2.0 Flash was shut down on June 1, 2026; use a current Gemini 3
# Get a key at https://aistudio.google.com/app/apikey
#
# GEMINI_API_KEY (single key) and GEMINI_API_KEYS (comma-separated) are now
# only a bootstrap fallback — used automatically when no key has been
# added yet through Admin Panel -> Gemini Pool. Once at least one key
# exists in the pool (MongoDB-backed), these env vars are ignored and the
# pool takes over: multiple keys, automatic failover on 429/503/timeout,
# and per-key health tracking. Existing single-key installs keep working
# with no changes required.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.7-flash
# Fallback model chain tried in order when a model is unavailable/exhausted.
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Model used by Admin Panel -> Gemini Pool "test key" (defaults to GEMINI_MODEL).
# GEMINI_TEST_MODEL=gemini-3.8-flash
# Max different models tried for a single request.
GEMINI_MAX_MODEL_ATTEMPTS=4
# Max output tokens requested per Gemini call.
GEMINI_MAX_OUTPUT_TOKENS=32768
# Maximum time this service waits for a complete app response from Gemini.
GEMINI_TIMEOUT_MS=180000
# Upper bound the per-call timeout may be raised to for large responses.
GEMINI_MAX_TIMEOUT_MS=180000
# Delay between agent/Gemini retries (ms).
GEMINI_RETRY_DELAY_MS=500
# Cooldown after a 429 rate limit, and its ceiling (ms).
GEMINI_RATE_LIMIT_COOLDOWN_MS=5000
GEMINI_RATE_LIMIT_COOLDOWN_MAX_MS=60000
# Provider-side model capacity cooldown (keeps overloaded models out of every key temporarily).
GEMINI_MODEL_CAPACITY_COOLDOWN_MS=30000

# ========================================
# GEMINI API KEY POOL — DEDICATED DATABASE
# Backend and ai-service both connect to this dedicated MongoDB database.
# Backend encrypts Gemini credentials before writing them; ai-service reads
# ciphertext and decrypts only immediately before Gemini requests.
GEMINI_MONGODB_URI=mongodb+srv://username:password@gemini-pool-cluster.mongodb.net/devdrop-gemini-pool

# MUST exactly match backend/.env's value. Used ONLY for Gemini API-key
# encryption/decryption. Never reuse TOKEN_ENCRYPTION_KEY here.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_GEMINI_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# How long (ms) the pool caches Mongo-loaded config before re-reading.
GEMINI_POOL_REFRESH_MS=5000

# Max Gemini requests a single key may have in flight at once. Leave unset
# for no per-key cap (only AI_CONCURRENCY governs total concurrency).
# GEMINI_PER_KEY_CONCURRENCY=1
# Maximum different credentials tried for one Gemini request. Default is all
# currently loaded keys. Set lower only if you intentionally want bounded failover.
GEMINI_POOL_MAX_KEY_ATTEMPTS=57

# Ceiling for Gemini pool exponential backoff after repeated key failures.
GEMINI_POOL_MAX_COOLDOWN_MS=300000

# Daily token budget per key before the pool stops using it.
GEMINI_DAILY_TOKEN_LIMIT=1500000

# ========================================
# RETRIES / RUNTIME VALIDATION LOOP
# ========================================
# Every generated or edited site goes through:
#   npm install -> npm run build -> on error, Debug Agent fixes -> repeat
# Max attempts per agent call when Gemini returns an invalid/failed response.
AGENT_MAX_RETRIES=5
# Generation: max build-fix repair rounds after a failed static check or build.
MAX_BUILD_FIX_RETRIES=3
# Edit: max repair rounds after an edit fails static check or build.
MAX_EDIT_REPAIR_RETRIES=1
# Standalone debug-repair endpoint: max fix/rebuild rounds.
MAX_DEBUG_RETRIES=5
# Max files the edit pipeline hands to the edit agent as context.
EDIT_MAX_RELEVANT_FILES=6
# Timeout for each `npm install` and `npm run build` of a generated project (ms).
AI_BUILD_TIMEOUT_MS=120000

# ========================================
# ORCHESTRATOR TIMEOUTS
# ========================================
# Single overall timeout for the ENTIRE whole-website generation pipeline
# (requirements -> design -> architecture -> code-gen for every file ->
# integration -> validation/debug repair loop). There is no longer a
# separate per-agent/per-stage timeout.
WEBSITE_GENERATION_TIMEOUT_MS=900000

# Single overall timeout for the ENTIRE incremental edit pipeline
# (relevant-files detection -> edit agent -> validation/debug repair loop).
WEBSITE_EDIT_TIMEOUT_MS=300000

# Backend endpoint ai-service pushes job progress to (replaces polling).
# Must be reachable from ai-service; usually http://localhost:5000/api/ai-generate/webhook
# or the deployed backend URL + /api/ai-generate/webhook.
BACKEND_WEBHOOK_URL=http://localhost:5000/api/ai-generate/webhook

# ========================================
# KASHI (DevDrop assistant) — GROQ POOL
# ========================================
# Kashi uses Groq, NEVER the Gemini pool. Groq keys live in the SAME MongoDB
# database as the Gemini pool (GEMINI_MONGODB_URI) in their own collection
# (`groqapikeys`) and are managed from Admin Panel -> Groq Pool. They are
# encrypted with the same AI_GEMINI_TOKEN_ENCRYPTION_KEY.
# GROQ_API_KEY / GROQ_API_KEYS are only a bootstrap fallback used when the
# pool collection is empty. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=gsk_one,gsk_two
# Fast model: quick answers to basic questions + app navigation.
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Edit model: fixes deployment build errors in code. Comma-separated list =
# fallback chain if a model is rejected/decommissioned.
GROQ_EDIT_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODELS=llama-3.1-8b-instant
# GROQ_EDIT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_TEST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=90000
GROQ_EDIT_MAX_TOKENS=8000
GROQ_FAST_MAX_TOKENS=700
GROQ_POOL_REFRESH_MS=5000
GROQ_POOL_MAX_COOLDOWN_MS=300000
GROQ_RATE_LIMIT_COOLDOWN_MS=15000
# Daily token budget per Groq key (0 = unlimited).
GROQ_DAILY_TOKEN_LIMIT=0
# "Fix only the error" guard: max edits per fix and max changed lines per fix.
KASHI_MAX_EDITS=8
KASHI_MAX_CHANGED_LINES=60

# ---- Runtime smoke test (black/white-screen protection) ----------------------
# After `vite build`, the generated site is opened in headless Chromium and fails
# on uncaught exceptions, console errors or an empty #root; Kashi uses the same
# engine to open a deployed site once Vercel says READY.
#   required (default) fail generation/Kashi checks when no browser can start
#   auto     run when a browser is available, otherwise skip with a warning
#   off      disable
AI_RUNTIME_CHECK=required
# AI_RUNTIME_CHECK_TIMEOUT_MS=25000
# AI_RUNTIME_CHECK_SETTLE_MS=1500
# AI_RUNTIME_AUTO_INSTALL_BROWSER=true
# AI_RUNTIME_BROWSER_INSTALL_TIMEOUT_MS=180000
