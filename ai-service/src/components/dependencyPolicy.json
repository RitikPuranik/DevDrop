    "motion": {
      "range": "^12.0.0",
      "family": "animation-engine",
      "weight": "medium",
      "notes": "import from 'motion/react'"
    },
    "gsap": {
      "range": "^3.12.5",
      "family": "timeline-animation",
      "weight": "medium"
    },
    "lucide-react": {
      "range": "^0.468.0",
      "family": "icons",
      "weight": "light"
    },
    "class-variance-authority": {
      "range": "^0.7.1",
      "family": "variants",
      "weight": "light"
    },
    "@radix-ui/react-accordion": {
      "range": "^1.2.2",
      "family": "headless-ui",
      "weight": "light"
    },
    "@radix-ui/react-slot": {
      "range": "^1.1.1",
      "family": "headless-ui",
      "weight": "light"
    },
    "embla-carousel-react": {
      "range": "^8.5.1",
      "family": "carousel",
      "weight": "medium"
    },
    "recharts": {
      "range": "^2.15.0",
      "family": "charts",
      "weight": "heavy"
    },
    "three": {
      "range": "^0.171.0",
