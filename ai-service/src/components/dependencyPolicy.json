    },
    "react-use-measure": {
      "range": "^2.1.7",
      "family": "measure",
      "weight": "light",
      "notes": "MIT on npm"
    },
    "border-beam": {
      "range": "^1.4.1",
      "family": "effects",
      "weight": "light",
      "notes": "MIT on npm"
    }
  },
  "aliases": {
    "framer-motion": "motion"
  },
  "alwaysAvailable": [
    "react",
    "react-dom"
  ]
