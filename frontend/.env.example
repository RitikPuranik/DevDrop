VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# PostHog Analytics
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Analytics
VITE_SENTRY_DSN=your_sentry_dsn

# AI Studio — client-side feature gate only (set to "false" to hide the
# entry point/route). No secrets belong here: the ai-service URL and
# its service auth token live server-side in backend/.env
# (AI_SERVICE_URL, AI_SERVICE_TOKEN) and must never be added as a
# VITE_* variable.
VITE_AI_STUDIO_ENABLED=true

