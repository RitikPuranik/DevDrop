# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/website-marketplace

# JWT
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=marketplace-files

# STRIPE (PAYMENT GATEWAY)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PLATFORM_ACCOUNT_ID=acct_xxxxxxxxxxxxx

# Email Service (Nodemailer with Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@yourplatform.com

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# Platform Configuration
PLATFORM_FEE_AMOUNT=100
TAX_PERCENTAGE=18

# File Upload Limits (in bytes)
MAX_FILE_SIZE_ZIP=104857600  # 100MB
MAX_FILE_SIZE_VIDEO=524288000  # 500MB
MAX_FILE_SIZE_PDF=10485760  # 10MB

# Signed URL Expiration (in seconds)
SIGNED_URL_EXPIRY=3600  # 1 hour

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
