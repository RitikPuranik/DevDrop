# ========================================
# SERVER
# ========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ========================================
# DATABASE
# Get free cluster: mongodb.com/atlas
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devdrop

# ========================================
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ========================================
JWT_SECRET=your_64_byte_hex_secret_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=another_64_byte_hex_secret_here
JWT_REFRESH_EXPIRE=30d

# ========================================
# RAZORPAY (Payments)
# Get from: razorpay.com → Settings → API Keys
# Use test keys for development (no KYC needed)
# ========================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Test card for test mode:
# Card: 4111 1111 1111 1111 | Expiry: any future | CVV: any | OTP: 123456

# ========================================
# PAYOUTS (Manual)
# Payouts to sellers are processed MANUALLY by the admin.
# No payout gateway needed — admin transfers funds directly
# via NEFT/IMPS/UPI using seller bank details shown in admin dashboard.
# ========================================

# ========================================
# EMAIL (Brevo)
# Get from: brevo.com → SMTP & API → API Keys
# ========================================

BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=yourgmail@gmail.com
ADMIN_EMAILS=yourgmail@gmail.com

# ========================================
# SUPABASE (File Storage)
# Get from: supabase.com → Project Settings → API
# ========================================
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=marketplace-files
# Runs every Sunday at 03:00 UTC.
SUPABASE_CLEANUP_CRON=0 3 * * 0

# ========================================
# PLATFORM FEES
# ========================================
PLATFORM_FEE_AMOUNT=100
TAX_PERCENTAGE=18

# ========================================
# FILE SIZE LIMITS (bytes)
# ========================================
MAX_FILE_SIZE_ZIP=104857600
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_PDF=10485760
SIGNED_URL_EXPIRY=604800

# ========================================
# AUCTION TIMING (hours)
# ========================================
AUCTION_BID_WAIT_HOURS=72
AUCTION_PAYMENT_HOURS=72

# ========================================
# RATE LIMITS
# Times are in milliseconds
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
DOWNLOAD_RATE_LIMIT_WINDOW_MS=3600000
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=50
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=3

# ========================================
# GOOGLE OAUTH
# Get from: console.cloud.google.com
# → APIs & Services → Credentials → OAuth 2.0 Client IDs
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ========================================
# GITHUB OAUTH (Export purchased projects)
# Get from: github.com/settings/developers → New OAuth App
# Authorization callback URL must be: <BACKEND_URL>/api/github/callback
# Scope requested is the minimum GitHub offers for creating/pushing
# repositories on the user's behalf (classic OAuth apps have no
# narrower "create repos only" scope).
# ========================================
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5000/api/github/callback

# 32-byte hex key used to encrypt stored GitHub access tokens at rest (AES-256-GCM).
# As of DevDrop Deploy, this same key also encrypts stored Vercel access
# tokens and Render API keys — TOKEN_ENCRYPTION_KEY is the more accurate name
# going forward, but GITHUB_TOKEN_ENCRYPTION_KEY still works as a fallback so
# existing deployments don't need to rotate anything.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Export creation is rate-limited per user (repo creation + file uploads are expensive).
EXPORT_RATE_LIMIT_WINDOW_MS=3600000
EXPORT_RATE_LIMIT_MAX_REQUESTS=5

# ========================================
# DEVDROP DEPLOY (Vercel + Render)
# Deploys an already-published GitHub repo into the BUYER's own Vercel and
# Render accounts — DevDrop never hosts the deployed app itself. Requires a
# GitHub OAuth connection (above) to read the published repository.
# ========================================

# --- Vercel ---
# Vercel's third-party API access is granted through an "Integration"
# registered in the Vercel Integration Console (vercel.com/dashboard —
# Integrations → Console → Create), NOT a generic OAuth /authorize URL like
# GitHub's. Registering one gives you a client id/secret and a slug; the
# Redirect URL you set there MUST match VERCEL_OAUTH_REDIRECT_URI exactly.
# See backend/src/services/deployment/providers/vercel.provider.js for the
# full explanation of how this flow differs from GitHub's — smoke-test the
# connect flow against a real integration before relying on it in production.
VERCEL_CLIENT_ID=your_vercel_integration_client_id
VERCEL_CLIENT_SECRET=your_vercel_integration_client_secret
VERCEL_INTEGRATION_SLUG=your-integration-slug
VERCEL_OAUTH_REDIRECT_URI=http://localhost:5000/api/deployments/providers/vercel/callback

# --- Render ---
# Render has no OAuth flow for the operations DevDrop needs — each user
# pastes their own personal API key (Render dashboard → Account Settings →
# API Keys) into DevDrop's "Connect Render" form. Nothing to register here;
# these two are just defaults for services DevDrop creates on users' behalf.
RENDER_DEFAULT_REGION=oregon
RENDER_DEFAULT_PLAN=free

# --- Shared ---
# Deployment creation/redeploy is rate-limited per user.
DEPLOY_RATE_LIMIT_WINDOW_MS=3600000
DEPLOY_RATE_LIMIT_MAX_REQUESTS=10
# How often (and how long) the orchestrator polls Vercel/Render for build status.
DEPLOY_POLL_INTERVAL_MS=5000
DEPLOY_POLL_TIMEOUT_MS=480000

# ========================================
# BACKUP & RESTORE
# Provide a SECOND MongoDB cluster + a SECOND Supabase project here.
# Admin Panel → Backup tab lets you mirror MAIN -> BACKUP on demand,
# restore BACKUP -> MAIN on demand, and a scheduled cron does
# MAIN -> BACKUP automatically. Leave blank to disable (cron auto-skips
# if unset). Every scheduled/full run REPLACES the backup's old data
# with a fresh copy of main — it does not pile up duplicates over time.
# ========================================
BACKUP_MONGODB_URI=mongodb+srv://username:password@backup-cluster.mongodb.net/devdrop

BACKUP_SUPABASE_URL=https://yourbackupproject.supabase.co
BACKUP_SUPABASE_SERVICE_ROLE_KEY=your_backup_project_service_role_key
BACKUP_SUPABASE_BUCKET_NAME=marketplace-files

# How often the automatic backup runs.
# EASIEST OPTION — just say how many hours between backups:
#   BACKUP_INTERVAL_HOURS=6     -> every 6 hours
#   BACKUP_INTERVAL_HOURS=24    -> once a day
#   BACKUP_INTERVAL_HOURS=0.5   -> every 30 minutes
BACKUP_INTERVAL_HOURS=24

# ADVANCED (optional) — exact time of day instead of an interval.
# Only used if BACKUP_INTERVAL_HOURS above is removed/blank.
# Cron syntax: minute hour day month weekday. Example = every day at 02:00 UTC.
# BACKUP_CRON_SCHEDULE=0 2 * * *

# ========================================
# SENTRY
# ========================================
SENTRY_DSN=your_sentry_dsn
