# ========================================
# SERVER
# ========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ========================================
# DATABASE
# Get free cluster: mongodb.com/atlas
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devdrop

# ========================================
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ========================================
JWT_SECRET=your_64_byte_hex_secret_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=another_64_byte_hex_secret_here
JWT_REFRESH_EXPIRE=30d

# ========================================
# CASHFREE (Payments + Payouts)
# Get from: cashfree.com → Developers → API Keys
# Use sandbox keys for development (no KYC needed)
# ========================================
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Test card for sandbox:
# Card: 4111 1111 1111 1111 | Expiry: any future | CVV: any | OTP: 111111

# ========================================
# EMAIL (Gmail + App Password)
# Google Account → Security → 2FA → App Passwords → Generate
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=yourgmail@gmail.com
ADMIN_EMAILS=yourgmail@gmail.com

# ========================================
# SUPABASE (File Storage)
# Get from: supabase.com → Project Settings → API
# ========================================
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET_NAME=marketplace-files

# ========================================
# PLATFORM FEES
# ========================================
PLATFORM_FEE_AMOUNT=100
TAX_PERCENTAGE=18

# ========================================
# FILE SIZE LIMITS (bytes)
# ========================================
MAX_FILE_SIZE_ZIP=104857600
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_PDF=10485760
SIGNED_URL_EXPIRY=604800
